@{
    ViewData["Title"] = "Registros y Pagos de Visitantes";
}

<div class="container mt-4">
    <h2 class="mb-4">Módulo de Visitantes, Precios y Pagos</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <div id="confeti" aria-hidden="true"></div>

        <script>
            const caja = document.getElementById("confeti");
            const colores = ["#ff4757", "#2ed573", "#1e90ff", "#ffa502", "#e056fd"];

            for (let i = 0; i < 80; i++) {
                const papelito = document.createElement("span");
                papelito.className = "confeti";
                papelito.style.left = Math.random() * 100 + "vw";
                papelito.style.backgroundColor =
                    colores[Math.floor(Math.random() * colores.length)];
                papelito.style.animationDuration = (2 + Math.random() * 2) + "s";

                caja.appendChild(papelito);
                setTimeout(() => papelito.remove(), 4000);
            }
        </script>
    }

    <div class="row">
        <div class="col-md-7">
            <div class="card shadow p-4 mb-4">
                <h4 class="mb-3 text-primary">Tarifas y Servicios Disponibles</h4>
                <p class="text-muted">Elige el servicio que deseas registrar para tu evento:</p>

                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Servicio / Tipo</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Paquete bodas gotico / clasico </strong></td>
                            <td>Recepción de invitados con brindis, cenas, cocteles, fogata, fiesta loca, recibimiento a los novios</td>
                            <td>$1.000.000 COP</td>
                        </tr>
                        <tr>
                            <td><strong>Paquete de cumpleaños</strong></td>
                            <td>(Varia según el requerimiento de cliente) torta, decoración </td>
                            <td>$1.000.000 en adelante</td>
                        </tr>
                        <tr>
                            <td><strong>baby shower</strong></td>
                            <td>Torta, decoración, recreacionista (la decoración, torta y recreacionista varia segun la tematica)</td>
                            <td>$120.000 COP</td>
                        </tr>
                        <tr>
                            <td><strong>Paquete religioso </strong></td>
                            <td>Torta, decoración, recreacionista (la decoración, torta y recreacionista varia segun la tematica)</td>
                            <td>$1.500.000 COP</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow p-4 bg-light">
                <h4 class="mb-3">Registrarse y Pagar</h4>

                <form asp-action="ProcesarPago" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <input type="text" class="form-control" name="NombreCompleto" placeholder="Ej.: Juan Pérez" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Correo Electrónico</label>
                        <input type="email" class="form-control" name="Correo" placeholder="correo@ejemplo.com" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Seleccionar Servicio</label>
                        <select class="form-select" name="TipoServicio" required>
                            <option value="">-- Seleccione una opción --</option>
                            <option value="Paquete bodas">Paquete bodas - $1.000.000 COP</option>
                            <option value="Pase VIP">Cumpleaños - $1.000.000 COP</option>
                            <option value="Baby Shower">Baby Shower - $1.000.000 COP</option>
                            <option value="Paquete religioso">Paquete religioso - $1.500.000 COP</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold d-block">Método de Pago</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="MetodoPago" id="pagoNequi" value="Nequi" required>
                            <label class="form-check-label" for="pagoNequi">
                                Nequi
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="MetodoPago" id="pagoBancolombia" value="Bancolombia">
                            <label class="form-check-label" for="pagoBancolombia">
                                Bancolombia
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="MetodoPago" id="pagoEfectivo" value="Efectivo">
                            <label class="form-check-label" for="pagoEfectivo">
                                Pago en efectivo (Sitio del evento)
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">
                        Confirmar Registro y Pagar
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver al inicio</a>
    </div>
</div>